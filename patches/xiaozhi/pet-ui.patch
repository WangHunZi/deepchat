+void Application::FinishTtsPlayback() {
+    // 只由主任务在收到 stop 且 AudioService 排空后调用，保持上游手动/自动模式语义。
+    if (listening_mode_ == kListeningModeManualStop) {
+        SetDeviceState(kDeviceStateIdle);
+    } else {
+        SetDeviceState(kDeviceStateListening);
+    }
+}
+
+void Application::CancelPetPresentation() {
+    // Idle -> Idle 不产生状态变更事件；等待回复时断连/重置要在此主动恢复画面。
+    const char* emotion = pet_.Cancel(GetDeviceState());
+    if (emotion != nullptr && last_error_message_.empty()) {
+        auto display = Board::GetInstance().GetDisplay();
+        display->SetPetMode(true);
+        display->SetEmotion(emotion);
     }
 }
 
