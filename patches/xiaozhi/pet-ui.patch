+void LcdDisplay::SetPetMode(bool enabled) {
+    if (!setup_ui_called_) return;
+    DisplayLockGuard lock(this);
+    if (!lock) return;
+    pet_mode_ = enabled;
+    if (!enabled) pet_feedback_active_ = false;
+    const char* text = chat_message_label_ != nullptr ? lv_label_get_text(chat_message_label_) : nullptr;
+    DCPetApplyLayout(top_bar_, status_bar_, bottom_bar_, enabled, hide_subtitle_, text != nullptr && text[0] != '\0');
+}
+
+void LcdDisplay::UpdateStatusBar(bool update_all) {
+    LvglDisplay::UpdateStatusBar(update_all);
+    DisplayLockGuard lock(this);
+    if (!lock) return;
+    // 沿用主任务每秒状态栏刷新；不在GIF计时回调内释放正在执行的播放器。
+    // 同一显示锁内检查并恢复，新的动作不会被过期的完成回调覆盖。
+    if (pet_mode_ && pet_feedback_active_ && gif_controller_ && !gif_controller_->IsPlaying()) {
+        SetEmotionLocked("neutral");
+    }
+}
